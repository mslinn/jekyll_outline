{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "args": [
        "_stuff",
      ],
      "cwd": "${workspaceFolder}/demo",
      "name": "Debug msls",
      "request": "launch",
      "script": "${workspaceFolder}/bin/msls",
      "type": "rdbg",
      "useBundler": true,
    },
    {
      "debugPort": "0",
      "name": "Attach rdbg",
      "request": "attach",
      "type": "rdbg",
    },
    {
      "name": "Attach with ruby_lsp",
      "request": "attach",
      "type": "ruby_lsp",
    },
    {
      "args": [
        "-I", "${workspaceFolder}/lib",
        "-I", "${workspaceFolder}/spec",
        "-P", "${workspaceFolder}/spec/**/*_spec.rb"
      ],
      "cwd": "${workspaceFolder}/demo",
      "debugPort": "0",
      "name": "RSpec - all",
      "request": "launch",
      "script": "${workspaceFolder}/binstub/rspec",
      "type": "rdbg",
    },
    {
      "args": [
        "-I", "${workspaceFolder}/lib",
        "-I", "${workspaceFolder}/spec",
        "${file}"
      ],
      "cwd": "${workspaceFolder}/demo",
      "debugPort": "0",
      "name": "RSpec - active spec only",
      "request": "launch",
      "script": "${workspaceFolder}/binstub/rspec",
      "type": "rdbg",
      "useBundler": true,
    }
  ]
}
